{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "paths": { "next/link": ["./link.tsx"] }
  },
  "include": ["app/**/*.tsx", "lib/**/*.ts", "main.tsx", "calendar.tsx", "link.tsx"]
}
