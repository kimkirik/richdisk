@@ -0,0 +1,96 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { getTideAdjustment, getVisibilityAdjustment } from '../lib/score-policy.ts';
+import { getWaterVisibility } from '../lib/water-visibility.ts';
+import { getMulTtae } from '../lib/tide-calendar.ts';
+import { SPOTS } from '../lib/spots.ts';
+
+test('only 4, 5 and 6 mul earn points across every supported phase', () => {
+  const expected = {'1물':0,'2물':0,'3물':0,'4물':15,'5물':15,'6물':15,'7물':0,'8물':0,'9물':-15,'10물':0,'11물':0,'12물':0,'13물':0,'조금':-15,'무시':0};
+  for (const [label, points] of Object.entries(expected)) assert.equal(getTideAdjustment(label), points, label);
+  for (const label of ['확인', '', '14물']) assert.equal(getTideAdjustment(label), null);
+});
+
+test('the displayed water-colour estimate maps to increasing negative adjustments', () => {
+  const data = (rain, wind = 0) => ({sourceStatus:{weather:true,recentRain:false},weather:{rain,wind,waveHeight:0},tides:[{height:600},{height:50}]});
+  const expected = [[0,0,'비교적 깨끗',0],[0.5,0,'약간 흐림',-10],[3,0,'많이 흐림',-20],[3,5,'커피물 가능성 큼',-30]];
+  for (const [rain, wind, level, penalty] of expected) {
+    const result = getWaterVisibility(data(rain, wind), '모래');
+    assert.equal(result.level, level);
+    assert.equal(getVisibilityAdjustment(result.level), penalty);
+  }
+  const missingWave = data(0); missingWave.weather.waveHeight = null;
+  assert.equal(getVisibilityAdjustment(getWaterVisibility(missingWave, '갯벌').level), null);
+  assert.equal(getVisibilityAdjustment(getWaterVisibility(null, '갯벌').level), null);
+});
+
+test('all configured places retain terrain for API and screen scoring', () => {
+  assert.ok(SPOTS.length > 50);
+  assert.ok(SPOTS.every(spot => spot.terrain && spot.source === spot.id));
+  assert.equal(new Set(SPOTS.map(spot => spot.source)).size, SPOTS.length);
+});
+
+const dates = Array.from({length: 32}, (_, i) => {
+  const day = new Date(); day.setUTCDate(day.getUTCDate() + i + 1);
+  return day.toISOString().slice(0, 10);
+});
+const items = rows => new Response(JSON.stringify({response:{header:{resultCode:'00'},body:{items:{item:rows}}}}));
+
+async function scenario(tag, run) {
+  const original = globalThis.fetch, oldKey = process.env.PUBLIC_DATA_API_KEY;
+  process.env.PUBLIC_DATA_API_KEY = 'fixture-key';
+  let current = {date: dates[0], rain: 0, wind: 0, wave: 0};
+  globalThis.fetch = async input => {
+    const url = new URL(String(input));
+    if (url.pathname.includes('tideFcstHghLw')) return items(['04:00','10:00','16:00','22:00'].map((time,i) => ({predcDt:current.date+' '+time,predcTdlvVl:i%2?'50':'600',extrSe:String(i+1)})));
+    if (url.pathname.includes('getVilageFcst')) {
+      const fields = {TMP:'20',WSD:String(current.wind),PCP:current.rain ? String(current.rain) : '강수없음',POP:'0',REH:'70',SKY:'1',PTY:current.rain ? '1' : '0',WAV:String(current.wave)};
+      if (current.wave === null) delete fields.WAV;
+      return items(Array.from({length:24},(_,hour) => Object.entries(fields).map(([category,fcstValue]) => ({category,fcstValue,fcstDate:current.date.replaceAll('-',''),fcstTime:String(hour).padStart(2,'0')+'00'}))).flat());
+    }
+    return new Response('',{status:503});
+  };
+  try {
+    let index = 0;
+    await run(async overrides => {
+      current = {...current,...overrides};
+      // Each scenario has independent conditions and provider caches.
+      const worker = (await import(`../dist/server/index.js?score=${tag}-${index++}`)).default;
+      return (await worker.fetch(new Request(`http://localhost/api/conditions?location=${overrides.location ?? 'anheung'}&date=${current.date}&precision=nearby`),{ASSETS:{fetch:async()=>new Response('',{status:404})}},{waitUntil(){},passThroughOnException(){}})).json();
+    });
+  } finally {
+    globalThis.fetch = original;
+    if (oldKey === undefined) delete process.env.PUBLIC_DATA_API_KEY; else process.env.PUBLIC_DATA_API_KEY = oldKey;
+  }
+}
+
+test('built API distinguishes preferred, penalized and neutral phases using the selected date', () => scenario('phases', async call => {
+  for (const [label, points, total] of [['3물',0,85],['4물',15,100],['5물',15,100],['6물',15,100],['7물',0,85],['9물',-15,70],['조금',-15,70],['무시',0,85]]) {
+    const date = dates.find(day => getMulTtae(day) === label);
+    assert.ok(date, label);
+    const data = await call({date, rain:0, wind:0, wave:0});
+    assert.equal(data.live, true);
+    assert.equal(data.mulTtae, label);
+    assert.equal(data.scoreBreakdown.tide, points);
+    assert.equal(data.score, total);
+    const terrain = SPOTS.find(spot => spot.source === 'anheung').terrain;
+    assert.deepEqual(data.waterVisibility, getWaterVisibility(data, terrain));
+    assert.equal(data.scoreBreakdown.visibility, getVisibilityAdjustment(data.waterVisibility.level));
+  }
+}));
+
+test('built API subtracts murky water, keeps missing water unknown, and retains the dangerous-weather cap', () => scenario('water', async call => {
+  const date = dates.find(day => getMulTtae(day) === '4물');
+  const clear = await call({date,rain:0,wind:0,wave:0,location:'gujina'});
+  const cloudy = await call({date,rain:0.5,wind:0,wave:0,location:'gujina'});
+  const murky = await call({date,rain:3,wind:0,wave:0,location:'gujina'});
