+  const unknown = await call({date,rain:0,wind:0,wave:null});
+  assert.equal(unknown.scoreBreakdown.visibility, null);
+  const dangerous = await call({date,rain:0,wind:10,wave:0});
+  assert.ok(dangerous.score <= 34);
+  assert.equal(dangerous.rating, '나쁨');
+  assert.ok(dangerous.riskFlags.includes('강풍 위험'));
+}));
