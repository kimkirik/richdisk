+++ b/tests/historical-weather.test.mjs
@@ -0,0 +1,75 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {parseDailyObservations,parseElementObservations,parseHourlyWind} from '../lib/historical-weather.ts';
+import {saveScoreHistory,readScoreHistory} from '../lib/score-history.ts';
+const daily='<table class="table-col table-cal"><tr><td>1일</td><td>2일</td><td>3일</td></tr><tr><td>평균기온:21.4℃ 최고기온:27.2℃ 평균운량:8.6 일강수량: - </td><td>평균기온:18.2℃ 평균운량:8.0 일강수량:12.3mm </td><td>평균기온: 최고기온:23.0℃ 일강수량: - </td></tr></table>';
+function table(value){return '<table id="weather_table"><tr><td>1일</td>'+Array.from({length:12},(_,i)=>`<td>${i===8?value:'&nbsp;'}</td>`).join('')+'</tr></table>';}
+test('daily KMA parser keeps month/day and distinguishes missing from dry weather',()=>{
+ const rows=parseDailyObservations(daily,'2026','09');assert.equal(rows.get('2026-09-01').rain,0);assert.equal(rows.get('2026-09-02').rain,12.3);assert.equal(rows.has('2026-09-03'),false);assert.equal(rows.size,2);
+});
+test('element parser reads raw m/s without executing display script, blanks remain missing',()=>{
+ assert.equal(parseElementObservations(table("<script>writeWindSpeed('1.1', false,'','',1);</script>"),'2026','wind').get('2026-09-01'),1.1);
+ assert.equal(parseElementObservations(table('<span>72.3</span>'),'2026','humidity').get('2026-09-01'),72.3);
+ assert.equal(parseElementObservations(table("<script>writeWindSpeed('&amp;nbsp;', false,'','',1);</script>"),'2026','wind').size,0);
+});
+const hourlyTable=(date='2026-09-07',station='129',count=22)=>`<input name="stn" value="${station}"><input name="tm" value="${date.replaceAll('-','.')}.23:00"><table id="weather_table">`+Array.from({length:24},(_,i)=>`<tr><td>${Number(date.slice(8))}.${String(i).padStart(2,'0')}H</td><td><script>writeWindSpeed('${i<count?(i===0?'0.0':'3.5'):'&amp;nbsp;'}',false,'','',1);</script></td></tr>`).join('')+'</table>';
+test('hourly wind keeps observed maximum and coverage; rejects wrong date, station and sparse data',()=>{
+ assert.deepEqual(parseHourlyWind(hourlyTable(),'2026-09-07','129'),{wind:3.5,hours:22});
+ assert.throws(()=>parseHourlyWind(hourlyTable(),'2026-09-08','129'),/날짜·지점/);
+ assert.throws(()=>parseHourlyWind(hourlyTable(),'2026-09-07','112'),/날짜·지점/);
+ assert.throws(()=>parseHourlyWind(hourlyTable('2026-09-07','129',12),'2026-09-07','129'),/충분하지/);
+});
+function storage(){let raw='{}';return {getItem(){return raw},setItem(k,v){raw=v}};}
+const sample={locationId:'gujina',date:'2026-09-12',sourceStatus:{tide:true,weather:true},score:75,rating:'좋음',updatedAt:'2026-09-11T10:00:00Z',weather:{kind:'forecast'}};
+test('a failed refresh cannot erase a known rating; observation and forecast are kept separately',()=>{
+ const store=storage();saveScoreHistory(store,sample,'gujina',sample.date);saveScoreHistory(store,{...sample,score:0,sourceStatus:{tide:true,weather:false}},'gujina',sample.date);
+ assert.equal(readScoreHistory(store,'gujina',sample.date).forecast.score,75);
+ saveScoreHistory(store,{...sample,score:65,rating:'보통',weather:{kind:'observation'}},'gujina',sample.date);
+ const result=readScoreHistory(store,'gujina',sample.date);assert.equal(result.forecast.rating,'좋음');assert.equal(result.observation.score,65);
+ assert.deepEqual(readScoreHistory(store,'other',sample.date),{forecast:undefined,observation:undefined});
