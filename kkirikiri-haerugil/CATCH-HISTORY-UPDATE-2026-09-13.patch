@@ -0,0 +1,32 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {CATCH_REPORTS,filterCatchReports,monthlyEvidence,regionalEvidence,catchReportsCsv} from '../lib/catch-evidence.ts';
+import {getScoreRating} from '../lib/score-policy.ts';
+test('all records have traceable, unique, public sources and explicit date basis',()=>{
+ assert.equal(new Set(CATCH_REPORTS.map(r=>r.id)).size,CATCH_REPORTS.length);
+ for(const r of CATCH_REPORTS){assert.equal(new URL(r.url).protocol,'https:');assert.ok(r.author&&r.dateEvidence&&r.limitation);if(r.caughtOn)assert.match(r.caughtOn,/^\d{4}-\d{2}(-\d{2})?$/);}
+ assert.equal(CATCH_REPORTS.length,14);assert.equal(new Set(CATCH_REPORTS.map(r=>r.region)).size,5);
+});
+test('May-published octopus report belongs to April; undated May post is excluded',()=>{
+ const may=filterCatchReports(CATCH_REPORTS,{species:'낙지',month:5});assert.equal(may.length,0);
+ const april=filterCatchReports(CATCH_REPORTS,{species:'낙지',month:4});assert.equal(april.length,1);assert.equal(april[0].postedOn,'2026-05-07');
+ assert.equal(monthlyEvidence(CATCH_REPORTS).reduce((n,r)=>n+r.reports,0),12);
+});
+test('source duplicates and fellow participants do not inflate record counts',()=>{
+ const r=CATCH_REPORTS[0];const clone={...r,id:'copied-post',url:r.url+'?category=42'};
+ assert.equal(filterCatchReports([r,r,clone]).length,1);assert.equal(regionalEvidence([r,r,clone],'낙지')[0].caught.size,1);
+});
+test('zero catches, low catches and observations remain distinct; trap fish excluded',()=>{
+ const records=filterCatchReports(CATCH_REPORTS,{spotId:'mongsanpo',species:'맛조개'});
+ const rows=regionalEvidence(records,'맛조개');assert.equal(rows.find(r=>r.month===5).none.size,1);assert.equal(rows.find(r=>r.month===10).poor.size,1);
+ assert.deepEqual(filterCatchReports(CATCH_REPORTS,{region:'경남 거제'})[0].catches.map(r=>r.result),['못 잡음']);
+ assert.equal(regionalEvidence(filterCatchReports(CATCH_REPORTS,{year:'2022'}),'주꾸미')[0].observed.size,1);
+});
+test('filters compose and CSV carries full source/date/quantity context',()=>{
+ const rows=filterCatchReports(CATCH_REPORTS,{year:'2024',month:5,region:'충남 태안',species:'맛조개'});assert.equal(rows.length,1);assert.equal(rows[0].caughtOn,'2024-05-11');
+ assert.equal(filterCatchReports(CATCH_REPORTS,{spotId:'gujina'}).length,0);
+ const csv=catchReportsCsv(rows);assert.ok(csv.startsWith('\uFEFF'));assert.ok(csv.includes('https://uncheat.tistory.com/33'));assert.ok(csv.includes('수량 미기록'));
+});
+test('rating boundaries use latest requested 50/70/85 policy',()=>{
+ for(const [n,label] of [[0,'비추'],[49.9,'비추'],[50,'보통'],[69.9,'보통'],[70,'좋음'],[80,'좋음'],[84.9,'좋음'],[85,'당장 가야 함'],[100,'당장 가야 함']])assert.equal(getScoreRating(n),label);
+});
